# 04-ciclos.otaku — Demuestra kamehameha (while) y entrenar (for).
# La variable del entrenar vive solo dentro del ciclo.

# kamehameha: repetir mientras la condición sea verdadera.
ninja energia = 100;
kamehameha (energia > 0) {
  gritar("Kamehameha! Energia restante:", energia);
  energia = energia - 30;
}

# entrenar: (inicial; condición; incremento).
gritar("Tabla del 2:");
entrenar (ninja i = 1; i <= 5; i = i + 1) {
  gritar("2 x", i, "=", 2 * i);
}

# entrenar hacia atrás.
gritar("Cuenta regresiva:");
entrenar (ninja j = 3; j > 0; j = j - 1) {
  gritar(j);
}
gritar("¡Despegue!");
